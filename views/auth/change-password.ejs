<%- include('../partials/head') %>
<section class="section auth">
  <div class="card auth-card">
    <h1>Đổi mật khẩu</h1>
    <p class="muted">Tài khoản: <%= user.email %></p>
    <form method="post" action="/doi-mat-khau" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% function field(name, label, autocomplete, hint) { %>
        <div class="field <%= errors[name] ? 'has-error' : '' %>">
          <label for="<%= name %>"><%= label %></label>
          <input id="<%= name %>" name="<%= name %>" type="password" autocomplete="<%= autocomplete %>" required
                 <% if (errors[name] || hint) { %>aria-describedby="<%= name %>-msg"<% } %>
                 <% if (errors[name]) { %>aria-invalid="true"<% } %>>
          <% if (errors[name]) { %><p class="field-error" id="<%= name %>-msg"><%= errors[name] %></p>
          <% } else if (hint) { %><p class="field-hint" id="<%= name %>-msg"><%= hint %></p><% } %>
        </div>
      <% } %>
      <% field('current_password', 'Mật khẩu hiện tại', 'current-password') %>
      <% field('password', 'Mật khẩu mới', 'new-password', 'Ít nhất 8 ký tự.') %>
      <% field('password_confirm', 'Nhập lại mật khẩu mới', 'new-password') %>
      <button class="btn btn-primary btn-block" type="submit">Lưu mật khẩu mới</button>
    </form>
    <p class="auth-switch"><a href="/tien-do">Quay lại trang tiến độ</a></p>
  </div>
</section>
<%- include('../partials/foot') %>

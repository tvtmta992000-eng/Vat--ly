<div class="sim-buttons">
  <% if (typeof label !== 'undefined' && label) { %>
    <button type="button" class="btn btn-primary btn-sm" data-action="toggle"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg><span><%= label %></span></button>
  <% } %>
  <button type="button" class="btn btn-ghost btn-sm" data-action="reset"><svg class="icon" aria-hidden="true"><use href="#i-reset"/></svg>Đặt lại</button>
</div>

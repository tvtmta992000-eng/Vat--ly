<div class="sim" data-sim="<%= sim.key %>">
  <div class="sim-stage">
    <canvas class="sim-canvas" width="720" height="400" role="img" aria-label="Mô phỏng <%= sim.title %>"></canvas>
    <% if (sim.key === 'induction') { %><p class="sim-hint">Kéo nam châm bằng chuột hoặc ngón tay, hoặc bấm “Tự động”.</p><% } %>
    <% if (sim.key === 'lens') { %><p class="sim-hint">Có thể kéo mũi tên (vật) trực tiếp trên hình.</p><% } %>
  </div>
  <div class="sim-panel">
    <%- include('../sims/' + sim.key) %>
  </div>
</div>
<script defer src="/js/sim-<%= sim.key %>.js"></script>

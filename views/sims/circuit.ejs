  <div class="sim-controls">
    <label class="slider"><span>Suất điện động $\mathcal{E}$</span> <output data-for="emf">12 V</output>
      <input type="range" name="emf" min="0" max="100" step="0.5" value="12" data-hard-min="0" data-hard-max="10000"></label>
    <label class="slider"><span>Điện trở trong r</span> <output data-for="internal">1 Ω</output>
      <input type="range" name="internal" min="0" max="20" step="0.1" value="1" data-hard-min="0" data-hard-max="10000"></label>
    <label class="slider"><span>Điện trở $R_1$</span> <output data-for="r1">6 Ω</output>
      <input type="range" name="r1" min="1" max="200" step="1" value="6" data-hard-min="0.01" data-hard-max="1000000"></label>
    <label class="slider"><span>Điện trở $R_2$</span> <output data-for="r2">3 Ω</output>
      <input type="range" name="r2" min="1" max="200" step="1" value="3" data-hard-min="0.01" data-hard-max="1000000"></label>
    <div class="segmented" role="radiogroup" aria-label="Cách mắc R1 và R2">
      <label><input type="radio" name="mode" value="series" checked><span>Nối tiếp</span></label>
      <label><input type="radio" name="mode" value="parallel"><span>Song song</span></label>
    </div>
  </div>
  <dl class="sim-readout">
    <div><dt>Điện trở mạch ngoài R</dt><dd data-out="rtotal">—</dd></div>
    <div><dt>Cường độ dòng điện I</dt><dd data-out="current">—</dd></div>
    <div><dt>Hiệu điện thế mạch ngoài U</dt><dd data-out="voltage">—</dd></div>
    <div><dt>Công suất mạch ngoài P</dt><dd data-out="power">—</dd></div>
  </dl>

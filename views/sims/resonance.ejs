<div class="sim-controls">
  <label class="slider"><span>Tần số ngoại lực $f$</span> <output data-for="fd">0,50 Hz</output>
    <input type="range" name="fd" min="0.1" max="3" step="0.01" value="0.5"></label>
  <label class="slider"><span>Tần số riêng $f_0$ của con lắc</span> <output data-for="f0">1,00 Hz</output>
    <input type="range" name="f0" min="0.5" max="2" step="0.05" value="1"></label>
  <label class="slider"><span>Lực cản (ma sát)</span> <output data-for="damp">Nhỏ</output>
    <input type="range" name="damp" min="0.05" max="1.5" step="0.05" value="0.15"></label>
  <div class="preset-row">
    <button type="button" class="chip-btn" data-action="match">Đặt $f = f_0$ (cộng hưởng)</button>
  </div>
</div>
<dl class="sim-readout">
  <div><dt>Tỉ số $f/f_0$</dt><dd data-out="ratio">—</dd></div>
  <div><dt>Biên độ hiện tại</dt><dd data-out="amp">—</dd></div>
  <div><dt>Biên độ khi ổn định</dt><dd data-out="steady">—</dd></div>
  <div><dt>Thời gian</dt><dd data-out="time">0,0 s</dd></div>
</dl>
<%- include('../partials/sim-buttons', { label: 'Chạy' }) %>

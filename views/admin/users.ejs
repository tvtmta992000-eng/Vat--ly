<%- include('../partials/head') %>
<section class="page-head admin-head">
  <div class="container">
    <h1>Người dùng</h1>
    <%- include('../partials/admin-nav') %>
  </div>
</section>
<section class="section section-tight">
  <div class="container">
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th scope="col">Họ tên</th><th scope="col">Email</th><th scope="col">Bài hoàn thành</th><th scope="col">Ngày tham gia</th><th scope="col">Vai trò</th></tr></thead>
        <tbody>
          <% users.forEach(function (u) { %>
            <tr>
              <td><strong><%= u.name %></strong></td>
              <td><%= u.email %></td>
              <td><%= u.completed %></td>
              <td class="muted small"><%= new Date(u.created_at).toLocaleDateString('vi-VN') %></td>
              <td>
                <% if (u.id === user.id) { %>
                  <%= roles[u.role] %> <span class="muted small">(bạn)</span>
                <% } else { %>
                  <form class="inline-form" method="post" action="/quan-tri/nguoi-dung/<%= u.id %>/vai-tro">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label class="sr-only" for="role-<%= u.id %>">Vai trò của <%= u.name %></label>
                    <select id="role-<%= u.id %>" name="role">
                      <% Object.keys(roles).forEach(function (r) { %><option value="<%= r %>" <%= u.role === r ? 'selected' : '' %>><%= roles[r] %></option><% }) %>
                    </select>
                    <button class="btn btn-ghost btn-sm" type="submit">Lưu</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>
<%- include('../partials/foot') %>

# Kết nối MySQL (lấy trong hPanel > Databases > MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_vatly
DB_PASSWORD=doi-mat-khau-nay
DB_NAME=u123456789_vatly

# Chuỗi bí mật dài, ngẫu nhiên để ký cookie phiên đăng nhập
